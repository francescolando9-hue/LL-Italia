# Configurazione locale con l'URL firmato dell'endpoint: mai nel repo pubblico.
core/configurazione.js

# Collaudi: dipendenza di sviluppo e materiale generato, mai nel repo.
collaudi/node_modules
collaudi/materiale/
# `npm install playwright` li scrive da sé (LEGGIMI, «Come si eseguono»):
# sono la dipendenza di sviluppo, non l'app, che resta senza npm.
collaudi/package.json
collaudi/package-lock.json

# Funzioni delle Segnalazioni: le dipendenze si installano al rilascio, e il
# pacchetto da caricare su Azure si costruisce lì. Mai nel repo.
funzioni/node_modules
funzioni/package-lock.json
funzioni/*.zip
